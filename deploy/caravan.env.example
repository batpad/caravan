# /etc/caravan/caravan.env — created by deploy.sh on first run (root:caravan 0640).
# Edit and re-run deploy.sh (or `systemctl restart caravan`) to apply.
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=caravan.whydidweevendothis.com
DJANGO_CSRF_TRUSTED_ORIGINS=https://caravan.whydidweevendothis.com
CARAVAN_HTTPS=true
CARAVAN_DB_PATH=/srv/caravan/data/db.sqlite3
CARAVAN_STATIC_ROOT=/srv/caravan/static
DJANGO_LOG_LEVEL=WARNING
